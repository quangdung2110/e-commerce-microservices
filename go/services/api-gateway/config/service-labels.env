# =============================================================================
# Service Labels Configuration for Docker Compose
# =============================================================================
# This file contains Traefik labels that should be added to each service.
# Copy the relevant section to your service's docker-compose.yml.
# =============================================================================

# =============================================================================
# USER SERVICE
# =============================================================================
# Add to user-service in docker-compose.yml:
# networks:
#   - ecommerce-network
# labels:
#   ${USER_SERVICE_LABELS}

USER_SERVICE_LABELS: |
  - "traefik.enable=true"
  - "traefik.http.routers.user-service.rule=PathPrefix(`/api/users`)"
  - "traefik.http.routers.user-service.entrypoints=websecure"
  - "traefik.http.routers.user-service.tls=true"
  - "traefik.http.routers.user-service.middlewares=jwt-auth-user,rate-limit-api,secure-headers"
  - "traefik.http.services.user-service.loadbalancer.server.port=8080"
  - "traefik.http.services.user-service.loadbalancer.server.scheme=http"
  - "traefik.http.services.user-service.loadbalancer.healthcheck.path=/health"
  - "traefik.http.services.user-service.loadbalancer.healthcheck.interval=10s"
  - "traefik.http.services.user-service.loadbalancer.healthcheck.timeout=5s"
  - "traefik.http.services.user-service.loadbalancer.healthcheck.expectedStatusCodes=200"
  - "traefik.http.routers.user-service.priority=10"

# =============================================================================
# ORDER SERVICE
# =============================================================================
# Add to order-service in docker-compose.yml:
# networks:
#   - ecommerce-network
# labels:
#   ${ORDER_SERVICE_LABELS}

ORDER_SERVICE_LABELS: |
  - "traefik.enable=true"
  - "traefik.http.routers.order-service.rule=PathPrefix(`/api/orders`)"
  - "traefik.http.routers.order-service.entrypoints=websecure"
  - "traefik.http.routers.order-service.tls=true"
  - "traefik.http.routers.order-service.middlewares=jwt-auth-order,rate-limit-api,secure-headers"
  - "traefik.http.services.order-service.loadbalancer.server.port=8080"
  - "traefik.http.services.order-service.loadbalancer.server.scheme=http"
  - "traefik.http.services.order-service.loadbalancer.healthcheck.path=/health"
  - "traefik.http.services.order-service.loadbalancer.healthcheck.interval=10s"
  - "traefik.http.services.order-service.loadbalancer.healthcheck.timeout=5s"
  - "traefik.http.services.order-service.loadbalancer.healthcheck.expectedStatusCodes=200"
  - "traefik.http.routers.order-service.priority=10"

# =============================================================================
# PRODUCT SERVICE
# =============================================================================
# Add to product-service in docker-compose.yml:
# networks:
#   - ecommerce-network
# labels:
#   ${PRODUCT_SERVICE_LABELS}

PRODUCT_SERVICE_LABELS: |
  - "traefik.enable=true"
  - "traefik.http.routers.product-service.rule=PathPrefix(`/api/products`)"
  - "traefik.http.routers.product-service.entrypoints=websecure"
  - "traefik.http.routers.product-service.tls=true"
  - "traefik.http.routers.product-service.middlewares=rate-limit-api@file,secure-headers@file"
  # Product listing is public (GET)
  - "traefik.http.routers.product-service-public.rule=PathPrefix(`/api/products`) && Method(GET)"
  - "traefik.http.routers.product-service-public.entrypoints=websecure"
  - "traefik.http.routers.product-service-public.tls=true"
  - "traefik.http.routers.product-service-public.service=product-service"
  - "traefik.http.services.product-service.loadbalancer.server.port=8080"
  - "traefik.http.services.product-service.loadbalancer.server.scheme=http"
  - "traefik.http.services.product-service.loadbalancer.healthcheck.path=/health"
  - "traefik.http.services.product-service.loadbalancer.healthcheck.interval=10s"
  - "traefik.http.services.product-service.loadbalancer.healthcheck.timeout=5s"
  - "traefik.http.services.product-service.loadbalancer.healthcheck.expectedStatusCodes=200"

# =============================================================================
# PAYMENT SERVICE
# =============================================================================
# Add to payment-service in docker-compose.yml:
# networks:
#   - ecommerce-network
# labels:
#   ${PAYMENT_SERVICE_LABELS}

PAYMENT_SERVICE_LABELS: |
  - "traefik.enable=true"
  - "traefik.http.routers.payment-service.rule=PathPrefix(`/api/payments`)"
  - "traefik.http.routers.payment-service.entrypoints=websecure"
  - "traefik.http.routers.payment-service.tls=true"
  - "traefik.http.routers.payment-service.middlewares=jwt-auth-payment,rate-limit-payment,secure-headers"
  - "traefik.http.services.payment-service.loadbalancer.server.port=8080"
  - "traefik.http.services.payment-service.loadbalancer.server.scheme=http"
  - "traefik.http.services.payment-service.loadbalancer.healthcheck.path=/health"
  - "traefik.http.services.payment-service.loadbalancer.healthcheck.interval=10s"
  - "traefik.http.services.payment-service.loadbalancer.healthcheck.timeout=5s"
  - "traefik.http.services.payment-service.loadbalancer.healthcheck.expectedStatusCodes=200"
  - "traefik.http.routers.payment-service.priority=10"

# =============================================================================
# AUTH SERVICE (JWKS Endpoint - No Auth Middleware)
# =============================================================================
# Add to auth-service in docker-compose.yml:
# networks:
#   - ecommerce-network
# expose:
#   - "8081"
# labels:
#   ${AUTH_SERVICE_LABELS}

AUTH_SERVICE_LABELS: |
  - "traefik.enable=true"
  # JWKS endpoint (for Gateway to fetch public keys)
  - "traefik.http.routers.auth-jwks.rule=Path(`/.well-known/jwks.json`)"
  - "traefik.http.routers.auth-jwks.entrypoints=websecure"
  - "traefik.http.routers.auth-jwks.tls=true"
  - "traefik.http.routers.auth-jwks.middlewares=rate-limit-auth"
  - "traefik.http.services.auth-jwks.loadbalancer.server.port=8081"
  # OpenID Connect discovery
  - "traefik.http.routers.auth-oidc.rule=Path(`/.well-known/openid-configuration`)"
  - "traefik.http.routers.auth-oidc.entrypoints=websecure"
  - "traefik.http.routers.auth-oidc.tls=true"
  - "traefik.http.routers.auth-oidc.middlewares=rate-limit-auth"
  - "traefik.http.services.auth-oidc.loadbalancer.server.port=8081"
  # Auth API endpoints (login, register, etc.)
  - "traefik.http.routers.auth-api.rule=PathPrefix(`/api/auth`)"
  - "traefik.http.routers.auth-api.entrypoints=websecure"
  - "traefik.http.routers.auth-api.tls=true"
  - "traefik.http.routers.auth-api.middlewares=rate-limit-auth"
  - "traefik.http.services.auth-api.loadbalancer.server.port=8081"

# =============================================================================
# LOAD BALANCING CONFIGURATION
# =============================================================================
# Default: Round Robin
# For Least Connections (useful for long-lived connections):
# Add to service labels:
#   - "traefik.http.services.SERVICE_NAME.loadbalancer.method=drr"  # Dynamic Round Robin
#
# For Weighted Round Robin:
# Add weighted servers:
#   - "traefik.http.services.SERVICE_NAME.loadbalancer.servers.weight=10"

# =============================================================================
# STICKY SESSIONS
# =============================================================================
# Enable sticky sessions (cookie-based):
#   - "traefik.http.services.SERVICE_NAME.loadbalancer.sticky.cookie=true"
#   - "traefik.http.services.SERVICE_NAME.loadbalancer.sticky.cookie.name=sticky_session"
#   - "traefik.http.services.SERVICE_NAME.loadbalancer.sticky.cookie.httpOnly=true"
#   - "traefik.http.services.SERVICE_NAME.loadbalancer.sticky.cookie.secure=true"
