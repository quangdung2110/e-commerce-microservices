# ====================
# API Gateway Environment Variables Template
# Copy to .env and fill in the values
# ====================

# ====================
# Traefik Configuration
# ====================
DOMAIN=api.ecommerce.local
TLS_EMAIL=admin@ecommerce.local
TRAEFIK_LOG_LEVEL=INFO

# ====================
# Redis Configuration
# ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# ====================
# Auth Service
# ====================
AUTH_SERVICE_URL=http://auth-service:8081
AUTH_SERVICE_JWKS_PATH=/.well-known/jwks.json

# ====================
# Backend Services
# ====================
USER_SERVICE_URL=http://user-service:8080
USER_SERVICE_PORT=8080

ORDER_SERVICE_URL=http://order-service:8080
ORDER_SERVICE_PORT=8080

PRODUCT_SERVICE_URL=http://product-service:8080
PRODUCT_SERVICE_PORT=8080

PAYMENT_SERVICE_URL=http://payment-service:8080
PAYMENT_SERVICE_PORT=8080

# ====================
# Distributed Tracing
# ====================
JAEGER_ENDPOINT=jaeger:4317
JAEGER_SAMPLING_RATE=1.0

# ====================
# JWT Middleware Configuration
# ====================
# JWKS Cache TTL (in minutes)
JWK_CACHE_TTL_MINUTES=10

# Redis key prefixes for denylist and revocation
DENYLIST_KEY_PREFIX=auth:denylist
REVOKED_BEFORE_PREFIX=auth:revoked_before

# Pub/Sub channel for JWKS invalidation
JWKS_INVALIDATE_CHANNEL=auth:jwks:update

# Headers to enrich (downstream)
HEADER_USER_ID=X-User-Id
HEADER_USER_ROLES=X-User-Roles
HEADER_USER_EMAIL=X-User-Email
HEADER_USER_DEVICE=X-User-Device-Id
HEADER_USER_SESSION=X-User-Session-Id

# Public paths (no auth required)
PUBLIC_PATHS=/health,/.well-known/,/api/auth/

# ====================
# Rate Limiting
# ====================
# Default rate limit
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# API rate limit
RATE_LIMIT_API_RPS=50
RATE_LIMIT_API_BURST=100

# Payment rate limit
RATE_LIMIT_PAYMENT_RPS=20
RATE_LIMIT_PAYMENT_BURST=40

# Auth rate limit
RATE_LIMIT_AUTH_RPS=10
RATE_LIMIT_AUTH_BURST=20

# ====================
# Docker Network
# ====================
COMPOSE_PROJECT_NAME=ecommerce
NETWORK_NAME=ecommerce-network

# ====================
# Dashboard Authentication
# ====================
# Generate with: htpasswd -nb admin password | tr -d ':\n' | sed 's/$/)/'
# Default: admin/password
TRAEFIK_DASHBOARD_AUTH=demo:$$apr1$$H6uskkkW$$IgXLP6ewTrSuBkTrqE8wj.
