{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/notification/v1/templates/ORDER_COMPLETED.schema.json",
  "title": "ORDER_COMPLETED template_data",
  "description": "Mọi line đã được Admin xác nhận đã giao; dẫn user tới review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "order_code",
    "completed_at",
    "items",
    "review_url"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19,
      "description": "Order-owned positive int64, base-10 không đệm."
    },
    "order_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "quantity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "variant_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "review_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "URL tuyệt đối tới frontend; Notification không tự lắp."
    }
  }
}
