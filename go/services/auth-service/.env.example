# Copy to .env for local development. Never commit real secrets.

# --- Datastores -------------------------------------------------------------
DB_PASSWORD=postgres
REDIS_PASSWORD=

# --- Signing key encryption -------------------------------------------------
# AES-256-GCM master key protecting the private JWT keys in auth.jwt_keys.
# Generate one with: openssl rand -base64 32
AUTH_KEYS_MASTER_KEY=

# --- Internal notification delivery / contact API ---------------------------
# mTLS and the per-principal policy are enforced by the service mesh, so Auth
# terminates no TLS itself. It only checks the X-Service-Identity header against
# this comma-separated allowlist as defence in depth (ADR-007).
AUTH_INTERNAL_ALLOWED_CALLERS=notification-service

# --- Overrides --------------------------------------------------------------
# Any configuration key can be overridden with an AUTH_-prefixed variable:
# AUTH_APP_ENV=development
# AUTH_JWT_ISSUER=https://auth.ecommerce.local
# AUTH_JWT_AUDIENCE=ecommerce-api
# AUTH_KAFKA_ENABLED=false
# AUTH_LOGGING_LEVEL=debug
