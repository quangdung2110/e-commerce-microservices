# Copy to .env for local development. Never commit real secrets.

# --- Datastores -------------------------------------------------------------
DB_PASSWORD=postgres
REDIS_PASSWORD=

# --- Internal checkout snapshot API -----------------------------------------
# The endpoint returns a recipient name, phone number and street address. mTLS
# and the per-principal policy are enforced by the service mesh; the service
# itself only checks X-Service-Identity against this comma-separated allowlist.
USER_INTERNAL_ALLOWED_CALLERS=checkout-service

# --- Overrides --------------------------------------------------------------
# Any configuration key can be overridden with a USER_-prefixed variable:
# USER_APP_ENV=development
# USER_APP_API_ENABLED=false
# USER_KAFKA_ENABLED=false
# USER_KAFKA_CONSUMER_ENABLED=false
# USER_WORKERS_RETENTION_PURGE_ENABLED=false
# USER_LOGGING_LEVEL=debug
