# Copy to .env for local development. Never commit real secrets.

# --- Datastores -------------------------------------------------------------
DB_PASSWORD=postgres
REDIS_PASSWORD=

# --- Internal checkout snapshot API (mTLS) ----------------------------------
# Required in production: the endpoint returns a recipient name, phone number
# and street address to its caller. Leave empty locally to run the internal
# listener without TLS on the compose network.
USER_INTERNAL_TLS_CERT_FILE=
USER_INTERNAL_TLS_KEY_FILE=
USER_INTERNAL_CLIENT_CA_FILE=
USER_INTERNAL_ALLOWED_CLIENT_CN=checkout-service

# --- Overrides --------------------------------------------------------------
# Any configuration key can be overridden with a USER_-prefixed variable:
# USER_APP_ENV=development
# USER_APP_API_ENABLED=false
# USER_KAFKA_ENABLED=false
# USER_KAFKA_CONSUMER_ENABLED=false
# USER_WORKERS_RETENTION_PURGE_ENABLED=false
# USER_LOGGING_LEVEL=debug
