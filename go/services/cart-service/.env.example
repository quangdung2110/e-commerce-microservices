# Cart Service — local overrides.
# Every value maps onto configs/application.yaml through the CART_ prefix
# (viper replaces the dots in a config path with underscores).

APP_ENV=development

# Redis: the cart source of truth. No PostgreSQL: Cart has no cold store.
CART_REDIS_ADDRS=localhost:6379
CART_REDIS_PASSWORD=
CART_REDIS_TLS_ENABLED=false

# Kafka: CART_ABANDONED out, ORDER_PAID in.
CART_KAFKA_BROKERS=localhost:9092

# Product Service gRPC.
CART_PRODUCT_ADDRESS=localhost:9091

CART_LOGGING_LEVEL=debug
