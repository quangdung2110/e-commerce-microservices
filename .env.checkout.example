# Copy these entries into root .env.local (ignored), then use --env-file .env.local.
# All keys must belong to the same Stripe Sandbox. Never use live keys for local tests.
PAYMENT_STRIPE_SECRET_KEY=sk_test_local_change_me
PAYMENT_STRIPE_PUBLISHABLE_KEY=pk_test_local_change_me
# Use the signing secret printed by the active `stripe listen` session.
PAYMENT_STRIPE_WEBHOOK_SECRETS=whsec_local_change_me
# Keep stable across restarts so persisted encrypted data remains readable (dev only).
PAYMENT_CRYPTO_LOCAL_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
