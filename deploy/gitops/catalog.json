{
  "schema_version": 1,
  "components": {
    "api-gateway": {
      "kind": "gateway",
      "ports": {
        "web": 8080,
        "metrics": 8090
      },
      "ready": "/ping",
      "live": "/ping",
      "probe_port": "metrics",
      "env": {
        "KUBERNETES_SERVICE_HOST": ""
      },
      "runtime_properties": [],
      "memory_request": "128Mi",
      "memory_limit": "512Mi"
    },
    "auth-service": {
      "kind": "go",
      "ports": {
        "http": 8080,
        "internal": 8081
      },
      "ready": "/health/ready",
      "live": "/health/live",
      "probe_port": "http",
      "env": {
        "AUTH_APP_ENV": "production",
        "AUTH_DATABASE_SSLMODE": "verify-full",
        "AUTH_JWT_ISSUER": "https://{domain}",
        "AUTH_JWT_AUDIENCE": "ecommerce-api",
        "AUTH_REFRESH_COOKIE_SECURE": "true",
        "AUTH_SECURITY_TRUSTED_PROXIES": "{trusted_proxy_cidrs}",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "{otlp_endpoint}",
        "OTEL_TRACES_SAMPLER_ARG": "{sampling}",
        "AUTH_REFRESH_COOKIE_DOMAIN": "{domain}"
      },
      "runtime_properties": [
        "AUTH_DATABASE_HOST",
        "AUTH_DATABASE_NAME",
        "AUTH_DATABASE_PORT",
        "AUTH_DATABASE_USERNAME",
        "AUTH_INTERNAL_SIGNING_KEY",
        "AUTH_KAFKA_BROKERS",
        "AUTH_KAFKA_SASL_PASSWORD",
        "AUTH_KAFKA_SASL_USERNAME",
        "AUTH_KEYS_MASTER_KEY",
        "AUTH_REDIS_HOST",
        "AUTH_REDIS_PORT",
        "DB_PASSWORD",
        "REDIS_PASSWORD"
      ],
      "memory_request": "128Mi",
      "memory_limit": "512Mi",
      "migration": "migrate"
    },
    "cart-service": {
      "kind": "go",
