        "OTEL_TRACES_SAMPLER_ARG": "{sampling}",
        "APP_ENV": "production",
        "CART_APP_ENV": "production",
        "CART_LOGGING_LEVEL": "info",
        "CART_MEDIA_REQUIRE_HTTPS": "true",
        "CART_MEDIA_CDN_BASE_URL": "https://{domain}/media",
        "CART_MEDIA_PLACEHOLDER_URL": "https://{domain}/media/placeholder/product.svg"
