// Bản Kubernetes của infra/observability/config.alloy. Phần trace giữ nguyên; log đọc qua Kubernetes API
// (loki.source.kubernetes) thay cho Docker API, service_name lấy từ nhãn app.kubernetes.io/name của pod.
otelcol.receiver.otlp "backend" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output { traces = [otelcol.processor.transform.privacy.input] }
}
otelcol.processor.transform "privacy" {
  error_mode = "ignore"
  trace_statements {
    context = "span"
    statements = [
      `delete_key(attributes, "url.full")`,
      `delete_key(attributes, "http.url")`,
      `delete_key(attributes, "url.path")`,
      `delete_key(attributes, "http.target")`,
      `delete_key(attributes, "url.query")`,
    ]
  }
  output { traces = [otelcol.processor.batch.backend.input] }
}
otelcol.processor.batch "backend" {
  timeout = "1s"
  send_batch_size = 512
  output { traces = [otelcol.exporter.otlp.jaeger.input] }
}
otelcol.exporter.otlp "jaeger" {
  client {
    endpoint = "jaeger:4317"
    tls { insecure = true }
  }
  sending_queue { enabled = true }
  retry_on_failure { enabled = true }
}

discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["ecommerce", "edge", "observability"]
  }
}
discovery.relabel "logs" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_container_init"]
    regex = "true"
    action = "drop"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label = "service_name"
  }
  // Workload Traefik tên traefik (deploy/mesh/topology.yaml); compose, metric và runbook gọi nó là api-gateway.
  rule {
    source_labels = ["service_name"]
    regex = "traefik"
    replacement = "api-gateway"
    target_label = "service_name"
  }
  // Cùng danh sách với bản compose: backend, gateway và stack observability; không thu log database/Kafka.
  rule {
    source_labels = ["service_name"]
    regex = "(search-service|review-service|product-service|promotion-service|inventory-service|order-service|payment-service|checkout-service|product-detail-bff|cart-service|auth-service|user-service|notification-service|gateway-auth|api-gateway|otel-collector|jaeger|loki|prometheus|alertmanager|grafana)"
    action = "keep"
  }
  // Nhãn project của compose (tên project compose); scripts/verify-observability.py lọc Loki theo nó.
  rule {
    target_label = "project"
    replacement = "e-commerce-microservices"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "namespace"
  }
}
loki.source.kubernetes "pods" {
  targets = discovery.relabel.logs.output
  forward_to = [loki.process.retention.receiver]
}
loki.process "retention" {
  // A first installation can discover logs older than Loki's retention window.
  stage.drop {
    older_than = "168h"
    drop_counter_reason = "outside_retention"
  }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
