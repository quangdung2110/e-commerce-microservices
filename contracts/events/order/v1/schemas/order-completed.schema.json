{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/order/v1/schemas/order-completed.schema.json",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "required": ["id", "type", "source", "dataschema", "subject", "sequence", "data"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "const": "com.ecommerce.order.completed.v1" },
        "source": { "const": "/services/order" },
        "dataschema": { "const": "/contracts/events/order/v1/schemas/order-completed.schema.json" },
        "subject": { "type": "string", "pattern": "^orders/[A-Za-z0-9_:.-]{1,64}$" },
        "sequence": { "type": "integer", "minimum": 1, "description": "The completed order lifecycle sequence." },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order_id", "user_id", "completed_at", "items"],
          "properties": {
            "order_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_:.-]{1,64}$",
              "description": "Opaque identifier owned by Order. Consumers MUST NOT parse, order by or derive anything from it. It is a string rather than an int64 because JSON numbers are IEEE-754 doubles in JavaScript, which silently rounds any value above 2^53-1." },
            "user_id": { "type": "string", "format": "uuid", "x-data-classification": "INTERNAL" },
            "completed_at": { "type": "string", "format": "date-time" },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "description": "Producers MUST NOT emit two entries with the same (product_id, sku_id): quantity carries the count. JSON Schema cannot express uniqueness on a key subset, so a consumer that receives a duplicate deduplicates on that key and keeps the first occurrence in array order.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["product_id", "sku_id", "variant_name", "quantity"],
                "properties": {
                  "product_id": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "sku_id": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "variant_name": { "type": ["string", "null"], "maxLength": 255 },
                  "quantity": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    }
  ]
}
