{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/product/v1/schemas/catalog-common.schema.json",
  "title": "Product catalog event common types",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "media_type", "storage_key", "sort_order"],
      "properties": {
        "media_id": { "$ref": "#/$defs/uuid" },
        "media_type": { "type": "string", "enum": ["IMAGE", "VIDEO"] },
        "storage_key": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "alt_text": { "type": ["string", "null"], "maxLength": 255 },
        "sort_order": { "type": "integer", "minimum": 0 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "category_id", "name", "slug", "attributes", "status", "catalog_revision", "updated_at"],
      "properties": {
        "product_id": { "$ref": "#/$defs/uuid" },
        "category_id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": ["string", "null"], "maxLength": 20000 },
        "attributes": { "type": "object", "maxProperties": 100, "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "HIDDEN"] },
        "catalog_revision": { "type": "integer", "minimum": 1 },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "sku": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku_id", "sku_code", "base_price_vnd", "selling_price_vnd", "status", "variant_attributes", "media", "thumbnail_storage_key", "updated_at"],
      "properties": {
        "sku_id": { "$ref": "#/$defs/uuid" },
        "sku_code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "base_price_vnd": { "type": "integer", "minimum": 1 },
        "selling_price_vnd": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "variant_attributes": { "type": "object", "maxProperties": 100, "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "media": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/media" } },
        "thumbnail_storage_key": { "type": ["string", "null"], "maxLength": 1024, "description": "Effective thumbnail: SKU IMAGE có sort_order nhỏ nhất, fallback Product IMAGE có sort_order nhỏ nhất, hoặc null." },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "category_path_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "name", "slug"],
      "properties": {
        "category_id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 160 }
      }
    },
    "facet_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "type"],
      "description": "Descriptor của một attribute được map trực tiếp vào category (ADR-019). label là tên hiển thị admin đặt cho attribute; type là value_type của attribute. Không mang option, required hay variant.",
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "type": "string", "enum": ["TEXT", "NUMBER", "BOOLEAN", "SELECT"] }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "name", "slug", "category_revision", "path", "is_leaf", "facet_definitions", "updated_at"],
      "properties": {
        "category_id": { "$ref": "#/$defs/uuid" },
        "parent_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category_revision": { "type": "integer", "minimum": 1 },
        "path": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/category_path_segment" } },
        "is_leaf": { "type": "boolean" },
        "facet_definitions": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "description": "Mapping category–attribute trực tiếp của category, sắp theo code; mảng rỗng khi chưa có mapping. Đổi tên attribute đã map tăng category_revision của mọi category map nó (ADR-019).",
          "items": { "$ref": "#/$defs/facet_definition" }
        },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
