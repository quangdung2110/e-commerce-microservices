{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/product/v1/schemas/product-deleted.schema.json",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    { "type": "object", "required": ["type", "source", "subject", "sequence", "data"], "properties": {
      "type": { "const": "com.ecommerce.catalog.product-deleted.v1" }, "source": { "const": "/services/product" },
      "subject": { "type": "string", "pattern": "^products/[0-9a-fA-F-]{36}$" }, "sequence": { "type": "integer", "minimum": 1 },
      "data": { "type": "object", "additionalProperties": false, "required": ["product_id", "sku_ids", "catalog_revision", "deleted_at"], "properties": {
        "product_id": { "$ref": "catalog-common.schema.json#/$defs/uuid" }, "sku_ids": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "$ref": "catalog-common.schema.json#/$defs/uuid" } },
        "catalog_revision": { "type": "integer", "minimum": 1 }, "deleted_at": { "$ref": "catalog-common.schema.json#/$defs/timestamp" }
      }}
    }}
  ]
}
