{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/product/v1/schemas/product-markdown-snapshot.schema.json",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "required": ["type", "source", "subject", "sequence", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.promotion.product-markdown-snapshot.v1" },
        "source": { "const": "/services/promotion" },
        "subject": { "type": "string", "pattern": "^products/[0-9a-fA-F-]{36}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product_id", "source_revision", "state"],
          "properties": {
            "product_id": { "$ref": "catalog-common.schema.json#/$defs/uuid" },
            "source_revision": { "type": "integer", "minimum": 1 },
            "state": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
            "promotion_rule_id": { "type": "integer", "minimum": 1 },
            "discount": { "$ref": "catalog-common.schema.json#/$defs/markdown_discount" },
            "starts_at": { "$ref": "catalog-common.schema.json#/$defs/timestamp" },
            "ends_at": { "$ref": "catalog-common.schema.json#/$defs/timestamp" },
            "inactive_reason": {
              "type": "string",
              "enum": ["NO_ACTIVE_RULE", "EXPIRED", "ADMIN_DISABLED"]
            }
          },
          "oneOf": [
            {
              "properties": { "state": { "const": "ACTIVE" } },
              "required": ["promotion_rule_id", "discount", "starts_at", "ends_at"],
              "not": { "required": ["inactive_reason"] }
            },
            {
              "properties": { "state": { "const": "INACTIVE" } },
              "required": ["inactive_reason"],
              "not": {
                "anyOf": [
                  { "required": ["promotion_rule_id"] },
                  { "required": ["discount"] },
                  { "required": ["starts_at"] },
                  { "required": ["ends_at"] }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
