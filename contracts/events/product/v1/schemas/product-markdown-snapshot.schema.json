{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/product/v1/schemas/product-markdown-snapshot.schema.json",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    { "type": "object", "required": ["type", "source", "subject", "sequence", "data"], "properties": {
      "type": { "const": "com.ecommerce.promotion.product-markdown-snapshot.v1" }, "source": { "const": "/services/promotion" },
      "subject": { "type": "string", "pattern": "^products/[0-9a-fA-F-]{36}$" }, "sequence": { "type": "integer", "minimum": 1 },
      "data": { "type": "object", "additionalProperties": false, "required": ["product_id", "promotion_rule_id", "source_revision", "state", "discount", "starts_at", "ends_at"], "properties": {
        "product_id": { "$ref": "catalog-common.schema.json#/$defs/uuid" }, "promotion_rule_id": { "type": "integer", "minimum": 1 },
        "source_revision": { "type": "integer", "minimum": 1 }, "state": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "discount": { "$ref": "catalog-common.schema.json#/$defs/markdown_discount" }, "starts_at": { "$ref": "catalog-common.schema.json#/$defs/timestamp" },
        "ends_at": { "$ref": "catalog-common.schema.json#/$defs/timestamp" }, "inactive_reason": { "type": "string", "enum": ["EXPIRED", "ADMIN_DISABLED", "PRODUCT_DELETED"] }
      }}
    }}
  ]
}
