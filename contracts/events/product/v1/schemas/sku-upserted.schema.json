{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/product/v1/schemas/sku-upserted.schema.json",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "required": ["type", "source", "subject", "sequence", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.catalog.sku-upserted.v1" },
        "source": { "const": "/services/product" },
        "subject": { "type": "string", "pattern": "^skus/[0-9a-fA-F-]{36}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "sku", "change_kind"],
          "properties": {
            "product": { "$ref": "catalog-common.schema.json#/$defs/product" },
            "sku": { "$ref": "catalog-common.schema.json#/$defs/sku" },
            "change_kind": { "type": "string", "enum": ["PRODUCT_CREATED", "PRODUCT_UPDATED", "PRODUCT_STATUS_CHANGED", "SKU_CREATED", "SKU_UPDATED", "MARKDOWN_REPRICED", "MARKDOWN_EXPIRED"] }
          }
        }
      }
    }
  ]
}
