{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/product/v1/schemas/catalog-reindex-requested.schema.json",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    { "type": "object", "required": ["type", "source", "subject", "data"], "properties": {
      "type": { "const": "com.ecommerce.catalog.reindex-requested.v1" }, "source": { "const": "/services/product" },
      "subject": { "type": "string", "pattern": "^categories/[0-9a-fA-F-]{36}$" },
      "data": { "type": "object", "additionalProperties": false, "required": ["reason", "root_category_id", "category_revision", "requested_at"], "properties": {
        "reason": { "const": "CATEGORY_TREE_CHANGED" }, "root_category_id": { "$ref": "catalog-common.schema.json#/$defs/uuid" },
        "category_revision": { "type": "integer", "minimum": 1 }, "requested_at": { "$ref": "catalog-common.schema.json#/$defs/timestamp" }
      }}
    }}
  ]
}
