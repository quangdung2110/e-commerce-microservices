{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/payment/v2/schemas/payment-event-common.schema.json",
  "title": "Payment financial event common envelope and scalar types v2",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "required": ["id", "source", "subject", "datacontenttype"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "source": { "const": "/services/payment" },
        "subject": { "$ref": "#/$defs/payment_subject" },
        "datacontenttype": { "const": "application/json" },
        "correlationid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "traceparent": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  ],
  "$defs": {
    "order_id": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
    "payment_transaction_id": { "type": "string", "pattern": "^TXN_[0-9A-HJKMNP-TV-Z]{26}$" },
    "refund_transaction_id": { "type": "string", "pattern": "^RFD_[0-9A-HJKMNP-TV-Z]{26}$" },
    "payment_subject": { "type": "string", "pattern": "^payments/TXN_[0-9A-HJKMNP-TV-Z]{26}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "machine_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "vnd_money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_minor", "currency"],
      "properties": {
        "amount_minor": { "type": "integer", "format": "int64", "minimum": 1 },
        "currency": { "const": "VND" }
      }
    },
    "payment_data": {
      "type": "object",
      "required": [
        "schema_version",
        "order_id",
        "payment_transaction_id",
        "payment_attempt_number",
        "financial_state_version",
        "occurred_at"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "order_id": { "$ref": "#/$defs/order_id" },
        "payment_transaction_id": { "$ref": "#/$defs/payment_transaction_id" },
        "payment_attempt_number": { "type": "integer", "format": "int32", "minimum": 1 },
        "financial_state_version": { "type": "integer", "format": "int64", "minimum": 1 },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "client_secret": false,
        "provider_transaction_id": false,
        "provider_charge_id": false,
        "provider_refund_id": false,
        "stripe_event_id": false,
        "payment_method": false,
        "payment_method_type": false,
        "user_id": false,
        "raw_body": false
      }
    },
    "refund_data": {
      "allOf": [
        { "$ref": "#/$defs/payment_data" },
        {
          "type": "object",
          "required": ["refund_transaction_id", "refund_amount"],
          "properties": {
            "refund_transaction_id": { "$ref": "#/$defs/refund_transaction_id" },
            "refund_amount": { "$ref": "#/$defs/vnd_money" }
          }
        }
      ]
    }
  }
}
