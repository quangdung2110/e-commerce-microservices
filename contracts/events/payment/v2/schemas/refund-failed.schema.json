{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/payment/v2/schemas/refund-failed.schema.json",
  "title": "Refund failed v2",
  "allOf": [
    { "$ref": "./payment-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "dataschema", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.payment.refund.failed.v2" },
        "dataschema": { "const": "/contracts/events/payment/v2/schemas/refund-failed.schema.json" },
        "data": {
          "type": "object",
          "allOf": [
            { "$ref": "payment-event-common.schema.json#/$defs/refund_data" },
            {
              "type": "object",
              "required": ["error_code"],
              "properties": {
                "error_code": { "$ref": "payment-event-common.schema.json#/$defs/machine_code" }
              }
            }
          ]
        }
      }
    }
  ]
}
