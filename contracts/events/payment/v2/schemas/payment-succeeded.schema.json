{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/payment/v2/schemas/payment-succeeded.schema.json",
  "title": "Payment succeeded v2",
  "allOf": [
    { "$ref": "./payment-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "dataschema", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.payment.transaction.succeeded.v2" },
        "dataschema": { "const": "/contracts/events/payment/v2/schemas/payment-succeeded.schema.json" },
        "data": {
          "type": "object",
          "allOf": [
            { "$ref": "payment-event-common.schema.json#/$defs/payment_data" },
            {
              "type": "object",
              "required": ["amount"],
              "properties": { "amount": { "$ref": "payment-event-common.schema.json#/$defs/vnd_money" } }
            }
          ]
        }
      }
    }
  ]
}
