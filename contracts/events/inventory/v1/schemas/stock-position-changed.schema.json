{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/inventory/v1/schemas/stock-position-changed.schema.json",
  "allOf": [
    { "$ref": "./inventory-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "subject", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.inventory.stock-position.changed.v1" },
        "dataschema": { "const": "/contracts/events/inventory/v1/schemas/stock-position-changed.schema.json" },
        "subject": { "type": "string", "pattern": "^stock-positions/[^/]{1,128}/[^/]{1,128}$" },
        "aggregatetype": { "const": "stock-position" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warehouse_id", "sku_id", "available_to_sell", "position_revision"],
          "properties": {
            "warehouse_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sku_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "available_to_sell": { "type": "integer", "minimum": 0 },
            "position_revision": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  ]
}
