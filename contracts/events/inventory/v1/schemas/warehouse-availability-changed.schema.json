{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/inventory/v1/schemas/warehouse-availability-changed.schema.json",
  "allOf": [
    { "$ref": "./inventory-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "subject", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.inventory.warehouse-availability.changed.v1" },
        "dataschema": { "const": "/contracts/events/inventory/v1/schemas/warehouse-availability-changed.schema.json" },
        "subject": { "type": "string", "pattern": "^warehouses/[^/]{1,128}$" },
        "aggregatetype": { "const": "warehouse" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warehouse_id", "is_active", "operational_state", "warehouse_revision"],
          "properties": {
            "warehouse_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "is_active": { "type": "boolean" },
            "operational_state": { "enum": ["UNKNOWN", "NORMAL", "OUTAGE"] },
            "warehouse_revision": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  ]
}
