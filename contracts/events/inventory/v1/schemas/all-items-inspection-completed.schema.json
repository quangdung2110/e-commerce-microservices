{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/inventory/v1/schemas/all-items-inspection-completed.schema.json",
  "allOf": [
    { "$ref": "./inventory-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "subject", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.inventory.refund.all-items-inspection-completed.v1" },
        "dataschema": { "const": "/contracts/events/inventory/v1/schemas/all-items-inspection-completed.schema.json" },
        "subject": { "type": "string", "pattern": "^orders/[^/]{1,128}/refund-scopes/[^/]{1,128}$" },
        "aggregatetype": { "const": "refund-scope" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refund_scope_id", "refund_request_id", "order_id", "scope_revision", "lines"],
          "properties": {
            "refund_scope_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "refund_request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "order_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "scope_revision": { "type": "integer", "minimum": 1 },
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["order_line_id", "sku_id", "expected_quantity", "received_quantity", "passed_quantity", "failed_quantity"],
                "properties": {
                  "order_line_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "sku_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "expected_quantity": { "type": "integer", "minimum": 1 },
                  "received_quantity": { "type": "integer", "minimum": 0 },
                  "passed_quantity": { "type": "integer", "minimum": 0 },
                  "failed_quantity": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  ]
}
