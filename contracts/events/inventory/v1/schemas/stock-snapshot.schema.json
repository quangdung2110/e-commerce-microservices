{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/inventory/v1/schemas/stock-snapshot.schema.json",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "required": ["type", "source", "subject", "sequence", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.inventory.stock-snapshot.v1" },
        "source": { "const": "/services/inventory" },
        "subject": { "type": "string", "pattern": "^skus/[0-9A-Za-z-]{1,64}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product_id", "sku_id", "available_quantity", "stock_revision", "observed_at"],
          "properties": {
            "product_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "sku_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "available_quantity": { "type": "integer", "minimum": 0 },
            "stock_revision": { "type": "integer", "minimum": 1 },
            "observed_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
