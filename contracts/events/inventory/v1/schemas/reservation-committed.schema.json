{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/inventory/v1/schemas/reservation-committed.schema.json",
  "allOf": [
    { "$ref": "./inventory-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "subject", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.inventory.reservation.committed.v1" },
        "dataschema": { "const": "/contracts/events/inventory/v1/schemas/reservation-committed.schema.json" },
        "subject": { "type": "string", "pattern": "^orders/[^/]{1,128}$" },
        "aggregatetype": { "const": "order-reservation" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order_id", "payment_reference", "reservation_revision", "lines"],
          "properties": {
            "order_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "payment_reference": { "type": "string", "minLength": 1, "maxLength": 128 },
            "reservation_revision": { "type": "integer", "minimum": 1 },
            "lines": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "./reservation-allocation-line.schema.json" } }
          }
        }
      }
    }
  ]
}
