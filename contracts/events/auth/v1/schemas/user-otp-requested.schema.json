{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User OTP Requested v1",
  "allOf": [
    { "$ref": "./auth-event-common.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.ecommerce.auth.user-otp-requested.v1" },
        "dataschema": { "const": "/contracts/events/auth/v1/schemas/user-otp-requested.schema.json" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery_id", "user_id", "purpose", "requested_at", "expires_at"],
          "properties": {
            "delivery_id": { "type": "string", "format": "uuid", "x-data-classification": "INTERNAL" },
            "user_id": { "type": "string", "format": "uuid", "x-data-classification": "INTERNAL" },
            "purpose": { "type": "string", "enum": ["REGISTRATION_VERIFICATION", "EMAIL_CHANGE_VERIFICATION"], "x-data-classification": "INTERNAL" },
            "requested_at": { "type": "string", "format": "date-time", "x-data-classification": "INTERNAL" },
            "expires_at": { "type": "string", "format": "date-time", "x-data-classification": "INTERNAL" }
          }
        }
      }
    }
  ]
}
