{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User Unlocked v1",
  "allOf": [
    { "$ref": "./auth-event-common.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.ecommerce.auth.user-unlocked.v1" },
        "dataschema": { "const": "/contracts/events/auth/v1/schemas/user-unlocked.schema.json" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery_id", "user_id", "unlocked_at"],
          "properties": {
            "delivery_id": { "type": "string", "format": "uuid", "x-data-classification": "INTERNAL" },
            "user_id": { "type": "string", "format": "uuid", "x-data-classification": "INTERNAL" },
            "unlocked_at": { "type": "string", "format": "date-time", "x-data-classification": "INTERNAL" }
          }
        }
      }
    }
  ]
}
