{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/notification/v1/schemas/notification-bounced.schema.json",
  "title": "Notification bounced v1",
  "description": "Provider báo bounce. Không mang địa chỉ; suppressed cho biết địa chỉ đã vào suppression list.",
  "allOf": [
    {
      "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "source",
        "dataschema",
        "subject",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "com.ecommerce.notification.bounced.v1"
        },
        "source": {
          "const": "/services/notification"
        },
        "dataschema": {
          "const": "/contracts/events/notification/v1/schemas/notification-bounced.schema.json"
        },
        "subject": {
          "$ref": "notification-event-common.schema.json#/$defs/outcome_subject"
        },
        "data": {
          "allOf": [
            {
              "$ref": "notification-event-common.schema.json#/$defs/outcome_core"
            },
            {
              "type": "object",
              "required": [
                "bounce_type",
                "suppressed"
              ],
              "properties": {
                "bounce_type": {
                  "type": "string",
                  "enum": [
                    "permanent",
                    "transient"
                  ]
                },
                "suppressed": {
                  "type": "boolean",
                  "description": "true khi Notification đã ghi suppression cho địa chỉ này."
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      }
    }
  ]
}
