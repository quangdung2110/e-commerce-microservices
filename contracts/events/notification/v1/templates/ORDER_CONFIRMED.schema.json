{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/notification/v1/templates/ORDER_CONFIRMED.schema.json",
  "title": "ORDER_CONFIRMED template_data",
  "description": "Xác nhận đơn đã thanh toán. Không có email, số điện thoại, địa chỉ chi tiết (chỉ tên người nhận + phường/quận/thành phố).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "order_code",
    "placed_at",
    "items",
    "subtotal_minor",
    "discount_minor",
    "shipping_fee_minor",
    "total_minor",
    "currency",
    "payment_method_label",
    "shipping_address",
    "order_url"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19,
      "description": "Order-owned positive int64, base-10 không đệm."
    },
    "order_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "placed_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "quantity",
          "unit_price_minor"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Tên sản phẩm tại thời điểm đặt (snapshot của Order)."
          },
          "variant_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Đơn vị nhỏ nhất của currency (VND: đồng)."
          }
        }
      }
    },
    "subtotal_minor": {
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "description": "Đơn vị nhỏ nhất của currency (VND: đồng)."
    },
    "discount_minor": {
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "description": "Đơn vị nhỏ nhất của currency (VND: đồng)."
    },
    "shipping_fee_minor": {
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "description": "Đơn vị nhỏ nhất của currency (VND: đồng)."
    },
    "total_minor": {
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "description": "Đơn vị nhỏ nhất của currency (VND: đồng)."
    },
    "currency": {
      "const": "VND"
    },
    "payment_method_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Nhãn hiển thị, ví dụ 'Thẻ Visa •••• 4242'. Không phải payment_method định danh."
    },
    "shipping_address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_name",
        "ward",
        "district",
        "city"
      ],
      "properties": {
        "recipient_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 201,
          "x-pii": true
        },
        "ward": {
          "type": "string",
          "maxLength": 128
        },
        "district": {
          "type": "string",
          "maxLength": 128
        },
        "city": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "order_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "URL tuyệt đối tới frontend; Notification không tự lắp."
    }
  }
}
