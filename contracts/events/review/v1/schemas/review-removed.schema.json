{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/review/v1/schemas/review-removed.schema.json",
  "allOf": [
    { "$ref": "./review-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "dataschema", "subject", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.review.removed.v1" },
        "dataschema": { "const": "/contracts/events/review/v1/schemas/review-removed.schema.json" },
        "subject": { "$ref": "review-event-common.schema.json#/$defs/review_subject" },
        "data": {
          "allOf": [
            { "$ref": "review-event-common.schema.json#/$defs/review_identity" },
            {
              "type": "object",
              "required": ["rating", "has_media", "was_counted"],
              "properties": {
                "rating": { "$ref": "review-event-common.schema.json#/$defs/rating" },
                "has_media": { "type": "boolean" },
                "was_counted": { "type": "boolean", "description": "True only when the review was APPROVED immediately before removal." }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      }
    }
  ]
}
