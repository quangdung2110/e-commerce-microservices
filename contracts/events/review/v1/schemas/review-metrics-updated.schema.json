{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/review/v1/schemas/review-metrics-updated.schema.json",
  "allOf": [
    { "$ref": "../../../../shared/json-schema/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "required": ["type", "source", "subject", "sequence", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.review.metrics-updated.v1" },
        "source": { "const": "/services/review" },
        "subject": { "type": "string", "pattern": "^product-rating-aggregates/[0-9A-Za-z-]{1,64}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product_id", "average_rating", "total_reviews", "review_revision", "observed_at"],
          "properties": {
            "product_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "average_rating": { "type": "number", "minimum": 0, "maximum": 5 },
            "total_reviews": { "type": "integer", "minimum": 0 },
            "total_with_media": { "type": "integer", "minimum": 0 },
            "review_revision": { "type": "integer", "minimum": 1 },
            "observed_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
