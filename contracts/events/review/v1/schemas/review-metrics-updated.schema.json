{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/review/v1/schemas/review-metrics-updated.schema.json",
  "allOf": [
    { "$ref": "./review-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "dataschema", "subject", "sequence", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.review.metrics-updated.v1" },
        "dataschema": { "const": "/contracts/events/review/v1/schemas/review-metrics-updated.schema.json" },
        "subject": { "type": "string", "pattern": "^product-rating-aggregates/[0-9A-Za-z-]{1,64}$" },
        "sequence": { "type": "integer", "minimum": 1, "description": "Must equal data.review_revision." },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product_id", "average_rating", "total_reviews", "total_with_media", "review_revision", "observed_at"],
          "properties": {
            "product_id": { "$ref": "review-event-common.schema.json#/$defs/product_id" },
            "average_rating": { "type": "number", "minimum": 0, "maximum": 5 },
            "total_reviews": { "type": "integer", "format": "int64", "minimum": 0 },
            "total_with_media": { "type": "integer", "format": "int64", "minimum": 0 },
            "review_revision": { "type": "integer", "format": "int64", "minimum": 1 },
            "observed_at": { "$ref": "review-event-common.schema.json#/$defs/timestamp" }
          }
        }
      }
    }
  ]
}
