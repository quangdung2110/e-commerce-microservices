{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/events/review/v1/schemas/review-approved.schema.json",
  "allOf": [
    { "$ref": "./review-event-common.schema.json" },
    {
      "type": "object",
      "required": ["type", "dataschema", "subject", "data"],
      "properties": {
        "type": { "const": "com.ecommerce.review.approved.v1" },
        "dataschema": { "const": "/contracts/events/review/v1/schemas/review-approved.schema.json" },
        "subject": { "$ref": "review-event-common.schema.json#/$defs/review_subject" },
        "data": {
          "allOf": [
            { "$ref": "review-event-common.schema.json#/$defs/review_identity" },
            {
              "type": "object",
              "required": ["rating", "has_media"],
              "properties": {
                "rating": { "$ref": "review-event-common.schema.json#/$defs/rating" },
                "has_media": { "type": "boolean" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      }
    }
  ]
}
