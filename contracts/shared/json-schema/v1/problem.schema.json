{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecommerce.local/shared/json-schema/v1/problem.schema.json",
  "title": "Problem Details",
  "description": "RFC 9457 Problem Details với extension chung của dự án.",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "title", "status", "detail", "instance", "code"],
  "properties": {
    "type": { "type": "string", "format": "uri-reference" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "detail": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "instance": { "type": "string", "format": "uri-reference" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "trace_id": { "type": "string", "minLength": 16, "maxLength": 64 },
    "retryable": { "type": "boolean", "default": false },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string", "maxLength": 200 },
          "message": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
