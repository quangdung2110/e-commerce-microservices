# Upstream của API Gateway (Traefik). Dùng cho rewrite `/api/**`, `/media/**` và
# cho Server Component gọi API công khai (src/lib/api/server.ts).
# Trong docker-compose để trống — mặc định là http://api-gateway:80.
# Chạy `npm run dev` ngoài Docker thì bỏ comment dòng dưới:
# API_UPSTREAM=http://localhost:8088

# Base URL công khai của media Product, để admin dựng URL ảnh từ `storage_key`
# (src/lib/media.ts). Mặc định `/media` — đi qua rewrite tới CDN giả MinIO ở local.
# Production đặt thành domain CDN, ví dụ https://cdn.example.com/product-media
# NEXT_PUBLIC_MEDIA_BASE_URL=/media
