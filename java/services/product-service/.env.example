# ============================================================
# Product Service — Environment Variables Template
# Copy to .env and fill in values for local development.
# ============================================================

# ── Spring Profile ───────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Database (PostgreSQL) ────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=postgressecret
# DB_URL is set in docker-compose.yml: jdbc:postgresql://postgres:5432/product_service

# ── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# ── gRPC ─────────────────────────────────────────────────
# Shared secret for internal service-to-service auth
GRPC_SECRET=dev-internal-secret-change-in-prod

# ── App Tuning ────────────────────────────────────────────
APP_CACHE_SKU_TTL_SECONDS=3600
APP_OUTBOX_BATCH_SIZE=100
APP_INVENTORY_SYNC_BATCH_SIZE=100
APP_INVENTORY_SYNC_INTERVAL_MS=500
APP_MARKDOWN_EXPIRY_CRON=0 0 3 * * ?
APP_LOCK_DISTRIBUTED_LOCK_TTL_SECONDS=30

# ── Logging ───────────────────────────────────────────────
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
