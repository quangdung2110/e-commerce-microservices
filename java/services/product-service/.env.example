# ============================================================
# Product Service — Environment Variables Template
# Stack local nằm ở docker-compose.yml của repo root.
# ============================================================

# ── Spring profile ───────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL ───────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:15432/product_service
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Kafka (chỉ consume markdown snapshot của Promotion) ───
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MARKDOWN_TOPIC=t.promotion.markdown.events
MARKDOWN_DLQ_TOPIC=t.promotion.markdown.events.dlq
MARKDOWN_GROUP_ID=product-markdown-consumer

# ── Ports ────────────────────────────────────────────────
SERVER_PORT=8081
GRPC_PORT=9091

# ── Ký cursor export nội bộ (secret manager ở môi trường thật) ──
EXPORT_CURSOR_SECRET=dev-export-cursor-secret-change-in-prod
