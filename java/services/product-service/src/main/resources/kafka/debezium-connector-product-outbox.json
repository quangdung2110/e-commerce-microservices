{
  "name": "product-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.SourceConnector",
    "tasks.max": "1",
    "database.hostname": "${DB_HOSTNAME:localhost}",
    "database.port": "${DB_PORT:5432}",
    "database.user": "${DB_USERNAME:postgres}",
    "database.password": "${DB_PASSWORD:postgres}",
    "database.dbname": "${DB_NAME:product_service}",
    "database.server.name": "product-db",
    "database.history.kafka.bootstrap.servers": "${KAFKA_BOOTSTRAP_SERVERS:localhost:9092}",
    "database.history.kafka.topic": "dbhistory.product-outbox",
    "publication.autocreate.mode": "filtered",
    "publication.name": "dbz_publication",
    "slot.name": "product_outbox_slot",
    "snapshot.mode": "initial",
    "table.include.list": "public.product_outbox_events",
    "topic.prefix": "product-db",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.topic.replacement": "t.product.events",
    "transforms.outbox.table.fields.additional.placement": "event_type:header:event_type,aggregate_type:header:aggregate_type,partition_key:header:partition_key",
    "transforms.outbox.route.by.field": "event_type",
    "transforms.outbox.route.tos": "CATEGORY_CREATED:t.category.events,CATEGORY_UPDATED:t.category.events,CATEGORY_DELETED:t.category.events",
    "transforms.outbox.key.enforce": "false",
    "transforms.outbox.value.envelope.schema.name": "io.debezium.outbox.event",
    "errors.tolerance": "none",
    "schema.history.internal.kafka.bootstrap.servers": "${KAFKA_BOOTSTRAP_SERVERS:localhost:9092}",
    "schema.history.internal.kafka.topic": "schema-changes.product-outbox",
    "consumer.override.max.poll.records": "100",
    "consumer.override.enable.auto.commit": "false",
    "poll.interval.ms": "1000",
    "max.batch.size": "2048",
    "max.queue.size.in.bytes": "1024000",
    "event.processing.failure.handling.mode": "fail",
    "tombstones.on.delete": "false"
  }
}
