{
  "name": "product-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "${DB_HOSTNAME:postgres}",
    "database.port": "${DB_PORT:5432}",
    "database.user": "${DB_USERNAME:postgres}",
    "database.password": "${DB_PASSWORD:postgres}",
    "database.dbname": "${DB_NAME:product_service}",
    "topic.prefix": "product-db",

    "plugin.name": "pgoutput",
    "publication.name": "dbz_product_outbox_publication",
    "publication.autocreate.mode": "filtered",
    "slot.name": "product_outbox_slot",
    "snapshot.mode": "no_data",
    "table.include.list": "public.product_outbox_events",
    "tombstones.on.delete": "false",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "transforms": "outbox,productTopic,categoryTopic,controlTopic",

    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "event_id",
    "transforms.outbox.table.field.event.key": "partition_key",
    "transforms.outbox.table.field.event.type": "event_type",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.expand.json.payload": "true",
    "transforms.outbox.table.fields.additional.placement": "event_type:header:ce_type,aggregate_type:header:ce_aggregate_type,aggregate_id:header:ce_aggregate_id",
    "transforms.outbox.route.by.field": "event_type",
    "transforms.outbox.route.topic.regex": "(?<routedByValue>.*)",
    "transforms.outbox.route.topic.replacement": "outbox.${routedByValue}",

    "transforms.productTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.productTopic.regex": "outbox\\.com\\.ecommerce\\.catalog\\.(sku|product)-(upserted|deleted)\\.v1",
    "transforms.productTopic.replacement": "t.product.events",

    "transforms.categoryTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.categoryTopic.regex": "outbox\\.com\\.ecommerce\\.catalog\\.category-(upserted|deleted)\\.v1",
    "transforms.categoryTopic.replacement": "t.category.events",

    "transforms.controlTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.controlTopic.regex": "outbox\\.com\\.ecommerce\\.catalog\\.reindex-requested\\.v1",
    "transforms.controlTopic.replacement": "t.catalog.control.events",

    "errors.tolerance": "none",
    "event.processing.failure.handling.mode": "fail",
    "max.batch.size": "2048",
    "max.queue.size": "8192",
    "poll.interval.ms": "500",

    "heartbeat.interval.ms": "60000",
    "provide.transaction.metadata": "false"
  }
}
