// Canonical Inventory projection for `stock-snapshot.v1`.
// Do not use scripted_upsert. The caller validates product_id + sku_id before
// this script runs. Required params: stock_revision (long), available_quantity
// (long), observed_at, indexed_at, event_id.
if (ctx._source.is_deleted == true) { ctx.op = 'none'; return; }
if (ctx._source.stock_revision != null
    && params.stock_revision <= ctx._source.stock_revision) {
  ctx.op = 'none';
  return;
}

ctx._source.available_quantity = params.available_quantity;
ctx._source.is_in_stock = params.available_quantity > 0;
ctx._source.stock_revision = params.stock_revision;
ctx._source.stock_observed_at = params.observed_at;
ctx._source.stock_indexed_at = params.indexed_at;
ctx._source.indexed_at = params.indexed_at;
ctx._source.last_stock_event_id = params.event_id;
