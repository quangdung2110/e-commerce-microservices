// Canonical Inventory-owned per-SKU availability patch.
// Do not use scripted_upsert: Product is the only source allowed to create a SKU document.
// Inventory guarantees readiness was registered before publishing this fact.
if (ctx._source.is_deleted == true) { ctx.op = 'none'; return; }
if (ctx._source.availability_revision != null
    && params.availability_revision <= ctx._source.availability_revision) {
  ctx.op = 'none';
  return;
}

ctx._source.is_in_stock = params.is_in_stock;
ctx._source.availability_revision = params.availability_revision;
ctx._source.availability_observed_at = params.observed_at;
ctx._source.availability_indexed_at = params.indexed_at;
ctx._source.indexed_at = params.indexed_at;
ctx._source.last_availability_event_id = params.event_id;
