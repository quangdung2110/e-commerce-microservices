{
  "index_patterns": ["categories_v*"],
  "aliases_note": "Alias doc: categories (read), categories_write (write).",
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "refresh_interval": "5s",
    "analysis": {
      "analyzer": {
        "vietnamese_analyzer": {
          "type": "custom",
          "tokenizer": "icu_tokenizer",
          "filter": ["icu_folding", "lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "category_id": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "vietnamese_analyzer",
        "fields": { "keyword": { "type": "keyword" } }
      },
      "slug": { "type": "keyword" },
      "parent_id": { "type": "keyword" },

      "level": { "type": "integer" },
      "path": { "type": "keyword" },
      "is_leaf": { "type": "boolean" },

      "product_count": { "type": "long" },
      "product_count_updated_at": { "type": "date" },

      "is_deleted": { "type": "boolean" },
      "deleted_at": { "type": "date" },

      "created_at": { "type": "date" },
      "updated_at": { "type": "date" },
      "indexed_at": { "type": "date" },

      "category_version": { "type": "date" },
      "tree_version": { "type": "long" },
      "last_event_id": { "type": "keyword" }
    }
  }
}
