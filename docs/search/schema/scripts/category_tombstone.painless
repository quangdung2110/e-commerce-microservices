// Canonical Category delete path for `category-deleted`.
// Do not use scripted_upsert. A missing category is a normal no-op handled by
// the caller. Required params: category_revision (long), deleted_at, indexed_at,
// event_id.
if (ctx._source.category_revision != null
    && params.category_revision <= ctx._source.category_revision) {
  ctx.op = 'none';
  return;
}

ctx._source.is_deleted = true;
ctx._source.deleted_at = params.deleted_at;
ctx._source.category_revision = params.category_revision;
ctx._source.category_indexed_at = params.indexed_at;
ctx._source.last_event_id = params.event_id;
